// Prisma Schema for MetrX - Legal Metrology Digital Verification System
// Smart India Hackathon (SIH 2026) Architecture

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SHOP_OWNER
  INSPECTOR
  ADMIN
  PUBLIC
}

model User {
  id               String   @id @default(uuid())
  name             String
  email            String   @unique
  password         String
  role             Role     @default(SHOP_OWNER)
  phone            String?
  inspectorBadgeId String?
  assignedZone     String?  @default("Ward 4 (Commercial Circle)")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  shops            Shop[]
}

model Shop {
  id                    String   @id @default(uuid())
  ownerId               String?
  owner                 User?    @relation(fields: [ownerId], references: [id])
  shopCode              String?  @unique // e.g., shop-1
  name                  String
  ownerName             String
  email                 String?
  branchType            String   @default("Main Commercial Branch")
  merchantUid           String   @unique // e.g., #EST-44091
  tradeLicense          String
  gstin                 String?
  shopActReg            String?
  zone                  String   @default("Ward 4 (Commercial Circle)")
  address               String
  phone                 String
  assignedInspector     String?  @default("Pending Admin Allocation")
  inspectorBadge        String?  @default("LM-PENDING")
  status                String   @default("Active Commercial Establishment")
  complianceStatus      String   @default("Pending Inspector Assignment")
  documentStatus        String   @default("not_uploaded")
  documentsRemarks      String?
  reviewedBy            String?
  documentSubmissionData Json?
  registeredScalesCount Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  instruments           Instrument[]
  verifications         Verification[]
  certificates          Certificate[]
}

model Instrument {
  id                     String   @id @default(uuid())
  shopId                 String
  shop                   Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  instrumentCode         String?  @unique // e.g. inst-1
  name                   String
  model                  String
  capacity               String
  serialNumber           String   @unique
  counter                String   @default("Billing Counter 1")
  status                 String   @default("Stamping Active")
  verificationStatusText String   @default("Holo Seal Valid")
  daysRemaining          Int      @default(365)
  totalDaysCycle         Int      @default(365)
  expiresOn              String
  sealNumber             String?
  complianceRate         String   @default("100%")
  type                   String   @default("counter_scale")
  class                  String   @default("Class III Commercial")
  photoUrl               String?
  verificationRuleId     String?
  verificationMode       String   @default("Field / In-Situ") // "Field / In-Situ" | "At Test Centre"
  isRepairedOrModified   Boolean  @default(false)
  verificationInterval   Int      @default(12) // in months
  lastVerifiedAt         DateTime?
  nextDueAt              DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  verifications          Verification[]
  inspections            InspectionRecord[]
}

model Verification {
  id                 String   @id @default(uuid())
  requestCode        String   @unique // e.g. VR-88412
  shopId             String
  shop               Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopName           String?
  ownerName          String?
  address            String?
  phone              String?
  instrumentId       String?
  instrument         Instrument? @relation(fields: [instrumentId], references: [id], onDelete: SetNull)
  instrumentName     String?
  serialNumber       String?
  assignedInspector  String   @default("Insp. R. Deshmukh")
  inspectorBadge     String   @default("LM-BLR-402")
  step               Int      @default(2) // 1: Requested, 2: Scheduled, 3: Inspected, 4: Stamped, 5: Certified
  status             String   @default("Verification Scheduled")
  slotDate           String?
  slotTime           String?  @default("Morning (09:30 - 12:30)")
  bookingRef         String?
  isPaid             Boolean  @default(true)
  feeAmount          Float    @default(850.0)
  paymentMethod      String   @default("UPI")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Certificate {
  id                  String   @id @default(uuid())
  certId              String   @unique // e.g. CERT-KA-2024-9921
  ruleForm            String   @default("Form XVII (Rule 14)")
  actYear             String   @default("Legal Metrology Act, 2009")
  shopId              String
  shop                Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  instrumentModel     String
  serialNumber        String
  verifiedDate        String
  validUntil          String
  inspectorSeal       String
  inspectorName       String   @default("Insp. R. Deshmukh")
  inspectorBadge      String   @default("LM-BLR-402")
  statusBadge         String   @default("CERTIFIED & COMPLIANT")
  workingStandardRef  String   @default("STD/KA/2024/0081 (Calibrated at NPL)")
  remarks             String   @default("4-Point MPE tested with Class M1 reference weights. Holographic wire seal applied.")
  qrCodeUrl           String?
  testObservationsRaw String?  // JSON stringified 4-point calibration loads
  applicableStandard  String?  @default("Legal Metrology (General) Rules, 2011 - Seventh Schedule")
  ruleName            String?  @default("Electronic Weighing Instrument Verification Standard")
  verificationMode    String?  @default("Field / In-Situ")
  status              String   @default("VALID") // VALID | EXPIRING_SOON | EXPIRED | REVOKED
  validUntilTimestamp DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model VerificationRule {
  id                   String   @id @default(uuid())
  name                 String
  instrumentType       String   // e.g. "Electronic Weighing Instrument", "Weighbridge", "Counter Scale", "Fuel Dispenser"
  instrumentClass      String   @default("Class III Commercial") // Category / Accuracy Class
  manufacturer         String?
  capacityMin          Float    @default(0)
  capacityMax          Float    @default(30)
  unit                 String   @default("kg")
  applicableStandard   String   // e.g. "Legal Metrology (General) Rules, 2011 - Seventh Schedule"
  verificationInterval Int      @default(12) // Months: 6, 12, 24, 36
  isActive             Boolean  @default(true)
  description          String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  checks               VerificationRuleCheck[]
  inspections          InspectionRecord[]
}

model VerificationRuleCheck {
  id               String   @id @default(uuid())
  ruleId           String
  rule             VerificationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  checkType        String   @default("checklist") // checklist | measurement | physical | evidence | gps
  isMandatory      Boolean  @default(true)
  requiresPhoto    Boolean  @default(false)
  requiresDocument Boolean  @default(false)
  sortOrder        Int      @default(0)

  criteria         VerificationRuleCriterion[]
  results          InspectionCheckResult[]
}

model VerificationRuleCriterion {
  id              String   @id @default(uuid())
  checkId         String
  check           VerificationRuleCheck @relation(fields: [checkId], references: [id], onDelete: Cascade)
  parameter       String   // e.g. "Accuracy at Nominal Load (10 kg)"
  referenceValue  Float    // e.g. 10.000
  tolerance       Float    // e.g. 0.005
  unit            String   @default("kg")
  comparisonType  String   @default("within_tolerance") // within_tolerance, greater_than_min, less_than_max, within_range, equal_to
  isMandatory     Boolean  @default(true)
}

model InspectionRecord {
  id                  String   @id @default(uuid())
  verificationId      String?
  instrumentId        String?
  instrument          Instrument? @relation(fields: [instrumentId], references: [id], onDelete: SetNull)
  shopId              String?
  ruleId              String?
  rule                VerificationRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  officerName         String   @default("Insp. R. Deshmukh")
  officerBadge        String   @default("LM-BLR-402")
  verificationMode    String   @default("Field / In-Situ") // "Field / In-Situ" | "At Test Centre"
  isRepairedOrModified Boolean @default(false)
  gpsLocation         String?  // lat, lng
  overallResult       String   // PASS | FAIL
  failureReasons      Json?    // Array of failure string reasons
  observations        String?
  certificateId       String?
  evidencePhotos      Json?    // Array of photo objects / names
  evidenceDocuments   Json?    // Array of doc objects / names
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  checkResults        InspectionCheckResult[]
}

model InspectionCheckResult {
  id              String   @id @default(uuid())
  inspectionId    String
  inspection      InspectionRecord @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  checkId         String?
  check           VerificationRuleCheck? @relation(fields: [checkId], references: [id], onDelete: SetNull)
  checkName       String
  observedValue   Float?
  referenceValue  Float?
  calculatedError Float?
  toleranceLimit  Float?
  result          String   // PASS | FAIL | NA
  remarks         String?
}

